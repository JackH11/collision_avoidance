; Engine configuration file — Godot 4.3 trajectory replay viewer.
; Python remains the sim/policy brain; this project only renders dumps.
config_version=5

[application]
config/name="Collision Avoidance Replay"
config/description="Pretty replay of dump_trajectory.py JSON (Phase 5)"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[display]
; High-res square for crisp MovieWriter / talk clips (was 960).
window/size/viewport_width=1920
window/size/viewport_height=1920
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="fractional"

[rendering]
; gl_compatibility: no Vulkan required on headless/CI (2D MSAA unsupported here).
; Crispness comes from 1920² + tight --view-radius crop + CRF 17 encode.
renderer/rendering_method="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.06, 0.08, 0.12, 1)

[debug]
gdscript/warnings/infer_typed_constants_on_export=0
gdscript/warnings/treat_warnings_as_errors=0

[input]
toggle_pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":32,"key_label":0,"unicode":32,"location":0,"echo":false,"script":null)
]
}
next_episode={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":78,"key_label":0,"unicode":110,"location":0,"echo":false,"script":null)
]
}
